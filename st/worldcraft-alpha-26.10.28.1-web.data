screenshot water-hitbox-1-pillar
hold Space 2
expect_player @2.75 @0.5 @4.2 0.1
look 30 -60
screenshot water-hitbox-2-swam-up

# On the walkway, only the north edge of their box over the channel, the
# water carries them east: 3 blocks in 2 seconds, at water's current of 1.5
# blocks a second.
teleport @1.5 @9.75 @0.5
look 0 -30
wait 2
expect_player @4.5 @9.75 @0.5 0.75
screenshot water-hitbox-3-carried

# Beside the foot of the waterfall, the water spreading from it pushes them
# away from it, east.
teleport @1.5 @20.5 @0
look 180 0
wait 1
expect_player @3 @20.5 @0 0.75
screenshot water-hitbox-4-away-from-fall
# Wood slabs and stairs: the same shapes as the stone ones, of planks. Walk
# up a climb of them without jumping, and place stairs facing the way you
# look. Players start with 64 of each.
# worldcraft --demo demos/wood_slabs_stairs.demo --demo-out demo_out
seed 12345
mobs off
view 4
window 1280 720

wait_loaded
time 0.5
mark

# Going east: a wood slab, east-facing wood stairs, a block of planks with a
# slab on it, a block of planks with stairs on it, then planks, each half a
# block higher than the last; then a wall, so the walk ends in a known place.
record off
fill @1 @-2 @0 @10 @2 @5 core:air
fill @1 @-2 @-1 @10 @2 @-1 worldcraft:stone
record on
fill @3 @-1 @0 @3 @1 @0 worldcraft:wood_slab
fill @4 @-1 @0 @4 @1 @0 worldcraft:wood_stairs[facing=east]
fill @5 @-1 @0 @7 @1 @0 worldcraft:planks
fill @5 @-1 @1 @5 @1 @1 worldcraft:wood_slab
fill @6 @-1 @1 @6 @1 @1 worldcraft:wood_stairs[facing=east]
fill @7 @-1 @1 @7 @1 @1 worldcraft:planks
fill @8 @-1 @2 @8 @1 @3 worldcraft:stone
teleport @0.5 @0.5 @0
look -30 -15
wait 0.3
screenshot wood-1-climb

# Walk up it holding W, without jumping: the player ends on the top block,
# two blocks up, against the wall.
look 0 0
hold W 2.5
wait 0.5
expect_player @7.68 @0.5 @2

# Placing: on a cleared stone floor south of the climb, stairs east, then
# north, and a slab.
record off
fill @-2 @-7 @0 @3 @-3 @4 core:air
fill @-2 @-7 @-1 @3 @-3 @-1 worldcraft:stone
teleport @0.5 @-4.5 @0
record on
wait_frames 2
expect_inventory worldcraft:wood_stairs 64
expect_inventory worldcraft:wood_slab 64
give worldcraft:wood_stairs 2 hand
look 0 -60
mouse right
look 90 -60
mouse right
give worldcraft:wood_slab 1 hand
look 180 -60
mouse right
expect @1 @-5 @0 worldcraft:wood_stairs[facing=east]
expect @0 @-4 @0 worldcraft:wood_stairs[facing=north]
expect @-1 @-5 @0 worldcraft:wood_slab
# Stepped back to look at them.
teleport @0.5 @-6.8 @0
look 90 -35
wait 0.3
screenshot wood-2-placed
{
  "worldcraft:water": {"frame_time": 0.5},
  "worldcraft:water_flow": {"frame_time": 0.4},
  "worldcraft:lava": {"frame_time": 0.3},
  "worldcraft:lava_flow": {"frame_time": 0.2},
  "worldcraft:fire": {"frame_time": 0.05}
}
