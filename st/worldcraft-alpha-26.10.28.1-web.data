# For terrain_reload.demo: the shipped terrain (assets/config/worldcraft/
# terrain.cfg), with the sea 68 blocks higher. A folder given to
# `terrain reload` only needs the files it changes.
sea_level = 330
# /terrain reload builds the terrain code first (#220), when the game runs
# from where it was built: the library builds in the background (a demo
# waits for it), and then the terrain is made again with it. From a release,
# there's nothing to build, and it reloads at once.
# worldcraft --demo demos/terrain_build.demo --demo-out demo_out
terrain_world
seed 1
view 4
window 1280 720

wait_loaded
time 0.5
# High over the land, looking out over it.
record off
teleport ~ ~ 345
look 30 -30
wait_loaded all
record on
wait 1

key T
type /terrain reload
wait 1
screenshot terrain-build-1-typing
key Return
expect_screen playing
# Once it has built, the terrain is made again.
expect_message terrain reloaded
wait 1
wait_loaded all
wait 2
screenshot terrain-build-2-reloaded
# The terrain world and /terrain reload (#206): the terrain made again from
# its files while the game runs. First a sea 68 blocks higher (from
# demos/terrain/high_sea), then another seed with that sea, then the
# shipped files again.
# worldcraft --demo demos/terrain_reload.demo --demo-out demo_out
terrain_world
seed 1
view 4
window 1280 720

wait_loaded
time 0.5
# High over the land (the terrain world flies; the clouds start at 360),
# looking out over it, without the HUD.
record off
teleport ~ ~ 345
look 30 -30
key F1
wait_loaded all
record on
expect ~ ~ 320 core:air
# Planks in the air, which a reload throws away.
setblock ~3 ~ 325 worldcraft:planks
wait 1
screenshot terrain-1-shipped

# The sea at 330: it floods the land up to there.
terrain reload terrain/high_sea
wait 1
wait_loaded all
expect ~ ~ 320 worldcraft:water
expect ~ ~ 329 worldcraft:water
expect ~ ~ 330 core:air
expect ~3 ~ 325 worldcraft:water
expect_player ~ ~ 345 0.5
wait 1
screenshot terrain-2-high-sea

# Another seed (lowland here), from the same files: the sea stays at 330.
terrain seed 12
wait 1
wait_loaded all
expect ~ ~ 330 core:air
expect_count ~-16 ~-16 329 ~15 ~15 329 worldcraft:water 1-1024
wait 1
screenshot terrain-3-seed-12

# The shipped files again: the sea goes back down to 262.
terrain reload
wait 1
wait_loaded all
expect_count ~-16 ~-16 300 ~15 ~15 329 worldcraft:water 0
wait 1
screenshot terrain-4-shipped-again
# TNT: breaking a block of it lights it. It falls if nothing's under it,
# and a second later explodes: it breaks the blocks around it (out to a
# lumpy edge, 3.5 to 5.75 blocks, different every time), which drop their
# items; throws mobs and items nearby away from it; and leaves a cloud of
# smoke. Any TNT it breaks is lit too, and goes off in turn.
# worldcraft --demo demos/tnt.demo --demo-out demo_out
seed 1
mobs off
view 4
window 1280 720

wait_loaded
time 0.5
mark

# A stone yard three blocks thick, cleared above. TNT floats 8 blocks up
# (further than an explosion reaches). Another sits on bedrock (which no
# explosion breaks, so it stays put) 3 blocks east, and planks 6 east: out
# of reach of the first explosion, in reach of the second. A heap of sand
# to the north, and a cow to the west, on bedrock so it can't just fall.
record off
fill @-8 @-8 @0 @14 @8 @12 core:air
fill @-8 @-8 @-3 @14 @8 @-1 worldcraft:stone
record on
setblock @0 @0 @8 worldcraft:tnt
setblock @3 @0 @-1 worldcraft:bedrock
setblock @3 @0 @0 worldcraft:tnt
setblock @6 @0 @0 worldcraft:planks
fill @-1 @-3 @0 @1 @-2 @1 worldcraft:sand
setblock @-4 @2 @-1 worldcraft:bedrock
spawn worldcraft:cow @-3.5 @2.5 @0
teleport @-7.5 @0.5 @0
look 0 -10
wait 0.5
screenshot tnt-1-before

# Light the floating one: it falls to the floor, then goes off there.
break @0 @0 @8
expect @0 @0 @8 core:air
wait 0.5
screenshot tnt-2-falling
wait 0.6
screenshot tnt-3-smoke
wait 0.2
# It fell: the floor under where it landed is gone (from up where it was
# lit, it couldn't have reached); the bedrock is still there.
expect @0 @0 @-1 core:air
expect @3 @0 @-1 worldcraft:bedrock
# What it broke lies around to be picked up, thrown by the blast: the
# stone and the sand (lit TNT drops nothing).
expect_drops @0 @0 @-1 6 worldcraft:stone 10-300
expect_drops @0 @-2 @0 10 worldcraft:sand 1-12
expect_drops @3 @0 @0 2 worldcraft:tnt 0
# A cloud of smoke.
expect_smoke 60-200
# The cow was thrown away from it.
expect_mobs @-4 @2 @0 1 0
expect_mobs @-4 @2 @0 16 1
# The TNT on the bedrock caught it, and is lit; the planks are still there.
expect @3 @0 @0 core:air
expect @6 @0 @0 worldcraft:planks

# A second later the second one goes off, reaching the planks, which drop.
wait 1.2
expect @6 @0 @0 core:air
expect_drops @6 @0 @0 10 worldcraft:planks 1
screenshot tnt-4-second
