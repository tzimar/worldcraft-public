expect_inventory worldcraft:bone 1-2
# Breaking (#72): every way a block breaks drops it, with particles. A torch
# on a dirt block whose dirt is mined, and a torch that water flows into.
# worldcraft --demo demos/breaking.demo --demo-out demo_out
seed 12345
