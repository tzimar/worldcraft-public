fill @100 @-33 @-1 @126 @-33 @-1 worldcraft:jack_o_lantern
fill @100 @-29 @-1 @126 @-29 @-1 worldcraft:jack_o_lantern
setblock @107 @-29 @0 worldcraft:torch[attach=floor]
setblock @115 @-28 @0 worldcraft:torch[attach=floor]
