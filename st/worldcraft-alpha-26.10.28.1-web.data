fill @100 @33 @-1 @126 @33 @-1 worldcraft:jack_o_lantern
fill @100 @43 @-1 @126 @43 @-1 worldcraft:jack_o_lantern
fill @118 @35 @0 @118 @44 @4 worldcraft:glass
fill @100 @38 @0 @126 @38 @4 worldcraft:stone
