¸c®‡R((Äv7­Š¡·f<‰2—ÂÌ2=ÖJA1=Âš5œb?·ôï)p‘'B³Ÿö=<¨oÖÛÚ'ıù–õùºFD°øED¼ã7”…gÉÛP™?ÏNIûˆ*ÄDR ’Ï¡ùÓ4ÏOÓD©\„©s!/Ùğ*¯w<¸ãÁ~<øÿµód”2ÀİÚ␀␀␀␀IEND®B`‚-- What the game's scripts are given: the ctx each hook is called with
-- (assets/item/README.md, assets/block/README.md, assets/npc/README.md).
-- Generated from src/worldcraft/script_api.cpp; the script_types test
-- checks it's up to date. For editors (luau-lsp's definitions files).

-- ctx.player: in every hook.
declare class Player
  -- Its hit points now.
  function health(self): number
  -- Its hit points at most.
  function max_health(self): number
  -- Heal it at once, up to full: the hit points healed (0 if dead or at full health).
  function heal(self, hp: number): number
  -- Heal it evenly over the seconds: false if refused (dead, full, or already healing with as much).
  function heal_over_time(self, hp: number, seconds: number): boolean
  -- Shoot a projectile the way it looks (only in an item's use).
  function shoot(self, projectile: string): boolean
  -- Check the room pointed into, saying in chat whether it suits an NPC (only in an item's use).
  function check_room(self): boolean
  -- Bring it back to life at its spawn point (only in a menu).
  function respawn(self): ()
end

-- ctx.item: in an item's use.
declare class Item
  -- The stack's item's name ("worldcraft:bandage").
  function name(self): string
  -- How many are in the stack.
  function count(self): number
  -- Use up n (1 if left out): how many are left.
  function take(self, n: number?): number
  -- Put a block (or a fluid's source) where it's pointed, as a held block is placed.
  function place(self, block: string): boolean
  -- Turn the stack into another item (an empty bucket).
  function become(self, item: string): ()
  -- Take up a fluid source pointed at, of those named, and become the item it names for it.
  function scoop_fluid(self, fluids: {[string]: string}): boolean
end

-- ctx.aim: in an item's use.
declare class Aim
  -- Whether it points at a block.
  function hit(self): boolean
  -- The block pointed at (nothing if none).
  function block(self): (number, number, number)
  -- The way the face pointed at faces (nothing if none).
  function face(self): (number, number, number)
end

-- ctx.block: in a block's use, place, on_break and on_hit, and a menu open on it.
declare class Block
  -- Where it is.
  function position(self): (number, number, number)
  -- Its type's name.
  function name(self): string
  -- Make it another block, by name with its states ("name[axis=value]").
  function set(self, block: string): boolean
  -- Open it if it's shut, shut it if it's open, all its parts (only in its use).
  function toggle_open(self): boolean
  -- Open its container: a crate (only in its use).
  function open_container(self): boolean
  -- Open a menu on it ("worldcraft:furnace"), once its use is done: false if what the menu shows isn't there (only in its use).
  function open_menu(self, menu: string): boolean
  -- Where the other of its pair is (a double chest's), or nothing.
  function partner(self): (number, number, number)
  -- Light it as TNT: it goes off a second later.
  function explode(self): ()
  -- In on_break: whether the player broke it.
  function broken_by_player(self): boolean
end

-- ctx.npc: in an NPC's talk, its lines' when, and a menu open on it.
declare class Npc
  -- Its personal name ("Jenny").
  function name(self): string
  -- "Jenny the Nurse".
  function full_name(self): string
  -- "Nurse".
  function role(self): string
  -- Whether it has a room.
  function has_room(self): boolean
  -- Say something in chat, as "Jenny the Nurse: text".
  function say(self, text: string): ()
  -- Throw n of an item (1 if left out) towards the player (only in talk).
  function give(self, item: string, n: number?): ()
  -- A whole number it keeps, saved with the world (0 if never set).
  function get(self, name: string): number
  -- Keep a whole number.
  function set(self, name: string, value: number): ()
  -- Say one of its lines, as when it's talked to: its talk, then its dialogue (only in a menu).
  function talk(self): ()
end

-- ctx.mob: in a mob's on_death.
declare class Mob
  -- Its type's name.
  function name(self): string
  -- Where it fell.
  function position(self): (number, number, number)
  -- Whether the player killed it.
  function killed_by_player(self): boolean
  -- Drop n of an item (1 if left out) where it fell.
  function drop(self, item: string, n: number?): ()
end

-- ctx.milestones: in a milestone's function.
declare class Milestones
  -- How many of the item the player has used.
  function used(self, item: string): number
  -- How many of the block the player has mined.
  function mined(self, block: string): number
end

-- ctx.menu: in a menu's functions.
declare class Menu
  -- Close the menu, once the function's done.
  function close(self): ()
  -- One of the menu's own values (nil if it hasn't been set).
  function get(self, name: string): (number | string)?
  -- Set one of the menu's own values, which a text shows as value "menu.<name>"; kept while it's open.
  function set(self, name: string, value: number | string | boolean): ()
  -- Open another menu in its place ("worldcraft:settings"), once the function's done: false if there's none.
  function open(self, menu: string): boolean
end

-- ctx.game: in a menu's functions.
declare class Game
  -- Save the world now.
  function save(self): ()
  -- Save and quit, once the function's done.
  function quit(self): ()
end

-- ctx.settings: in a menu's functions.
declare class Settings
  -- A number setting ("view_distance", "fov", "mouse_sensitivity").
  function get(self, name: string): number
  -- Change a number setting by `by`, rounded to whole steps and kept in its range; saved when the menu closes.
  function step(self, name: string, by: number): ()
end

-- ctx.world: in every hook.
declare class World
  -- Say something in chat.
  function message(self, text: string): ()
  -- 0 to 1, from midnight.
  function time_of_day(self): number
  -- Whether the stars are out.
  function is_night(self): boolean
  -- Days the world has run.
  function days(self): number
  -- The name of the block there ("" where it isn't loaded).
  function block(self, x: number, y: number, z: number): string
  -- Set a block there: false if it can't be.
  function set_block(self, x: number, y: number, z: number, block: string): boolean
end

-- What a hook is called with: player and world always, the rest as
-- the hook is about them.
type Ctx = {
  player: Player,
  item: Item?,
  aim: Aim?,
  block: Block?,
  npc: Npc?,
  mob: Mob?,
  milestones: Milestones?,
  menu: Menu?,
  game: Game?,
  settings: Settings?,
  world: World,
}
# Demos

A demo is a script of inputs that the game plays back instead of reading the
mouse and keyboard. Use one to drive the game and take screenshots without
touching the real input devices:

    worldcraft --demo demos/tour.demo --demo-out demo_out

While a demo plays:

- The game starts a fresh world from the demo's seed, in a temporary folder
  that is deleted afterwards. It uses default settings and never writes
  `settings.cfg`.
- Game time moves a fixed 1/60 s per frame, whatever the real frame rate.
  While `wait_loaded` runs, game time stands still.
- Real mouse and keyboard input is ignored, and the mouse isn't captured.
- The game quits when the script ends.

So a demo plays out the same way every run. The one exception is mobs, which
wander from wherever they spawned; use `mobs off` for exactly repeatable
screenshots.

## Recording a GIF

Add `--gif <file>` to record the playback as an animated GIF:

    worldcraft --demo demos/blocks.demo --demo-out demo_out --gif demo_out/blocks.gif

- It records game time, at 10 frames a second, so it plays at the game's
  speed. `wait_loaded` is left out, including the player landing after
  loading. So is anything between `record off` and `record on`.
- Frames are shrunk to 400 pixels wide. `--gif-width <px>` and
  `--gif-fps <n>` change that.
- The log (`<demo-out>/worldcraft.log`) says how big the GIF came out, and
  warns if it's over 5 MB. A moving camera costs about 25 KB a frame at
  the defaults; a still one, very little.

## Format

One command per line. `#` starts a comment. Each command is written below
as the game reads it: `<...>` is a value, a bare word is that word, `a|b`
is either, and `[...]` may be left out. To add a command, add its row to the
table in `src/worldcraft/demo.cpp` (its name, these arguments, and how they
should be checked), its case in `src/app/demo_runner.cpp`, and its row here
(a test checks every command has one).

### Setup (before any other command)

| Command | Meaning |
|---|---|
| `seed <n>` | World seed (default 1). |
| `mobs on\|off` | Spawn mobs (default on). |
| `view <chunks>` | View distance, 1-16 (default 8). |
| `window <w> <h>` | Window size in pixels (default 1280 720). |
| `world <name> [keep]` | Play in a world with this name (letters, digits, `-`, `_`), started fresh; with `keep`, in that world as an earlier demo left it, to check what was saved (see `save_1.demo` and `save_2.demo`). Without it, each demo has a fresh world of its own. |
| `terrain_world` | Play in the terrain world (as `--terrain-world`): never saved, with no mobs, and the player flying and in god mode. Only there does `terrain` work. Not with `world`. |

### Commands

Commands run in order. Most take no time. The ones marked *1 frame* end the
current frame, so the next command runs a frame later.

| Command | Meaning |
|---|---|
| `wait <seconds>` | Let game time run. |
| `wait_frames <n>` | Let game time run for `n` frames. |
| `wait_loaded [all] [<timeout>]` | Freeze game time until the chunks around the player (3x3x3) have loaded and been drawn, then run it until the player stops falling (at most 5 seconds). Gives up on loading after `timeout` real seconds (default 120). Use it at the start and after `teleport`. Chunks further away may still be loading. With `all`, wait until everything in view is loaded and drawn (nothing left to load for 30 frames): slower, for screenshots of the view. |
| `key <key> [down\|up]` | Press and release a key (*1 frame*); with `down` or `up`, hold it or let it go. |
| `hold <key> <seconds>` | Hold a key for that long. |
| `mouse left\|right [down\|up]` | Click a mouse button in the world (*1 frame*); with `down` or `up`, hold it or let it go (holding left breaks blocks). |
| `move <x> <y>` | Move the cursor to a window pixel (for menus). |
| `click <x> <y>` | Move the cursor there and left-click (*1 frame*). |
| `turn <dx> <dy>` | Move the mouse by that many pixels, so the view turns by the mouse sensitivity. |
| `look <yaw> <pitch>` | Face a direction, in degrees. Yaw 0 faces east (+X), 90 north; pitch -89 to 89. |
| `face_mob <mob>` | Turn to look at the nearest mob of that type (an NPC's type, such as `worldcraft:nurse`), at its middle. |
| `wheel <notches>` | Scroll; positive is up. |
| `teleport <x> <y> <z>` | Put the player's feet at that position. |
| `tp <x> <y> <z>` | The same as `teleport`. |
| `time <0-1>` | Set the time of day: 0 midnight, 0.25 sunrise, 0.5 noon, 0.75 sunset. |
| `iso_screenshot <name>` | Save an isometric screenshot (F11) of the square of chunks round the player to `<demo-out>/<name>.png`. It waits, with game time frozen, until every chunk in the square is drawn. |
| `screenshot <name>` | Save a frame to `<demo-out>/<name>.png` (*1 frame*). It waits, with game time frozen, until the chunks around the player are drawn as they are, so blocks just changed show. |
| `record off\|on` | Leave what follows out of the GIF (see below), or start recording again. |
| `quit` | Stop here. |

### Blocks

These set up a scene, or check what happened, without aiming at anything.
Positions are whole blocks. Block names are as the game registers them,
with the state for blocks that have several (`worldcraft:log[oriented=z]`;
a block's name alone is its default state); air is `core:air`.

| Command | Meaning |
|---|---|
| `setblock <x> <y> <z> <block>` | Put a block there. |
| `fill <x1> <y1> <z1> <x2> <y2> <z2> <block>` | Fill the box between two corners, inclusive (at most 32768 blocks). |
| `break <x> <y> <z>` | Break the block there as the player would: particles, and its drops pop out. |
| `expect <x> <y> <z> <block>` | Check the block there. The result is printed (`ok` or `FAILED, found ...`), and if any check fails the game exits with code 1. A block name without a state (`worldcraft:log`) accepts any of its states. |

Unknown block names are reported when the world opens, before anything plays.

### Checks

Checks make a demo an in-game test. Each prints its result (`ok`, or
`FAILED` with what it found), the demo ends with how many passed, and if
any failed the game exits with code 1. A count can be a range, `1-2`, for
things that vary (how many bones a skeleton drops). Item and mob names are checked when
the world opens, before anything plays.

| Command | Checks that... |
|---|---|
| `expect <x> <y> <z> <block>` | the block there is `<block>` (see Blocks). |
| `expect_player <x> <y> <z> [<tolerance>]` | the player's feet are at that point, within `tolerance` blocks on each axis (default 0.05). |
| `expect_drops <x> <y> <z> <radius> <item> <count>` | exactly `count` of `<item>` lie on the ground within `radius` blocks of that block's centre (0 for none). Items are picked up when the player walks over them, so check before moving. |
| `expect_drop_stacks <x> <y> <z> <radius> <item> <count>` | `<item>` lies within `radius` blocks of that block's centre in exactly `count` separate drops (stacks), however many items each holds. Drops of the same item lying together merge. |
| `expect_count <x1> <y1> <z1> <x2> <y2> <z2> <block> <count>` | `count` of `<block>` are in the box between those corners (a block without a state counts any of its states). |
| `expect_inventory <item> <count>` | the player has exactly `count` of `<item>`, in the inventory and crafting grid. |
| `expect_profiled <section>` | the profiling section with that path (`render`, `world/streaming`; see the F3 chart) was timed in the last second. |
| `expect_untracked <ms> [<section>]` | frames in the last second spent, on average, no more than that outside every top-level profiling section (gaps in the profiling); with a section, in that section but outside the sections inside it (its "(rest)" in the F3 table). An average, so one frame the system happened to pause in a gap doesn't fail it; the log shows the worst frame too. |
| `expect_mobs <x> <y> <z> <radius> <count>` | exactly `count` living mobs are within `radius` blocks of that block's centre. |
| `expect_window fullscreen\|windowed` | the window is fullscreen, or a window. |
| `expect_screen playing\|inventory\|crafting_table\|settings\|death\|command\|furnace\|chest\|large_chest\|shop` | that screen is open: playing (no menu), the command line, or a menu by its name without its namespace: the inventory, a crafting table's, the settings, the death menu, a furnace's, a chest's, a pair of chests', or a merchant's shop. |
| `expect_image <name> <width> <count>` | `<demo-out>/<name>.png` (a screenshot the demo took) is `width` pixels across and `count` down (or `min-max`). |
| `expect_health <count>` | the player has `count` hit points (20 is full: two to a heart). |
| `expect_smoke <count>` | `count` puffs of smoke are in the air (torches' and explosions'). |
| `expect_furnace <x> <y> <z> ingredient\|fuel\|result <item> <count>` | the furnace at that block holds `count` of `<item>` in that slot. |
| `expect_chest <x> <y> <z> <item> <count>` | the chest at that block holds `count` of `<item>`, over all its slots (that chest alone, not a chest it's paired with). |
| `expect_swing on\|off` | the player's hand is swinging (hitting, or mining while the button's held) or at rest. |
| `expect_pickups <count>` | `count` items the player has picked up are still flying to them (for a fifth of a second after each is picked up). |
| `expect_flames <count>` | `count` flames are burning on blocks (torches) in the chunks around the player (3x3x3), each giving off smoke. |
| `expect_guttering <x> <y> <z> on\|off` | the light at that block is (`on`) or isn't (`off`) showing that a monster is coming to snuff it: a torch's flame is drawn guttering, or a lamp is flickering. |
| `expect_cloud_shadow <x> <y> <z> on\|off` | a cloud at that point would be in shadow (`on`: something above it blocks the sky, like a sky island) or not (`off`), as the clouds are drawn. |
| `expect_sky_light <x> <y> <z> <count>` | the sky light at that block is `count` (0-15, or a range like `12-15`), as it was last drawn: 15 is open sky. Check it once the block's chunk is drawn as it is, after `wait_loaded` or a `screenshot`. |
| `expect_message <text>` | one of the command line's last 10 messages has `<text>` in it (the rest of the line): what a command typed into it (`type`) said. |
| `expect_gl_clean` | OpenGL hasn't reported an error since the game started (each is also logged as it happens, the first few). The renderer keeps to what both desktop OpenGL 3.3 and WebGL 2 allow, so a demo with this check at its end shows it does, on either. |
| `expect_atlas_border <texture>` | the texture (`worldcraft:stone`) is in the atlas, and the border round its place repeats its edge pixels, so a face drawn with it can't pick up a neighbouring texture at its edges. |

### Setting up

| Command | Meaning |
|---|---|
| `give <item> <count> [hand]` | Put items in the player's inventory; with `hand`, in the hotbar slot they're holding, replacing what was there. |
| `spawn <mob> <x> <y> <z>` | A new mob (`worldcraft:cow`, `worldcraft:skeleton`, ...) with its feet there. |
| `hurt <x> <y> <z> <radius> <damage>` | Hurt every mob within `radius` blocks of that block's centre by `damage` hit points, the way a hit does (enough kills it). |
| `mark` | Remember the block holding the player's feet, for `@` positions. |
| `god [on\|off]` | God mode, or (with no word) switch it: nothing hurts the player, blocks break at once, and placing a block doesn't use it up. Not saved, like flying. |
| `fly [on\|off]` | Fly, or (with no word) switch flying, as K does. |
| `noclip [on\|off]` | Fly through blocks, with no collision, or (with no word) switch it. Turning it on starts flying; turning it off leaves the player flying, and stopping flying (K, or `fly off`) stops it too. Not saved, like flying. |
| `terrain reload\|seed [<value>]` | In the terrain world only: make the terrain again, throwing away every chunk (edits, mobs and drops with them). `terrain reload` loads the terrain code again if it's been rebuilt; when the game runs from where it was built, it builds it first (as `build --terrain` does), and the demo waits, with game time stopped, until it has. It then reads the terrain files from the assets (`config/worldcraft/terrain.cfg` and `ores.lua`); `terrain reload <folder>` reads any of them that are in that folder instead (relative to the demo's folder, as `terrain/high_sea`). `terrain seed <n>` makes it again from another seed, with the same files. If the files (or the terrain library) have a problem, it says so and nothing changes. A player the new ground would bury is moved up out of it. |
| `textures reload` | Read every texture from disk again, with the texture packs as they are now: the atlas's (blocks, items, mobs, and the animated ones from `texture/animations.lua`), the compass, the sun and moon, the lightmap, and the interface's. Each keeps its place in the atlas, so a picture must still fit its old size (a bigger one is cropped, with a warning), and a PNG that has gone keeps its old pixels. A new texture file shows once something uses it. |
| `sky_rays on\|off` | Light with sky rays or without them (`config/worldcraft/sky_light.cfg`): with them, a cell under something high up (a sky island) is lit by how many rays from it, climbing sideways, get past everything to the sky. `on` reads the file again, so it can be changed while the game runs. Everything is redrawn. |
| `type <text>` | Type the rest of the line, as if on the keyboard: into the command line, once `key T` has opened it (then `key Return` runs it). |

### In the game: the command line

T opens a command line in the bottom left, which runs these same commands
as `/<command> <args>`: `/tp ~ ~ ~10`, `/give worldcraft:torch 64`,
`/god`, `/fly`. It runs the ones that happen at once: every command above
except those that take time, stand in for the keyboard and mouse, or record
the demo (`wait`, `key`, `mouse`, `screenshot`, `type`, ...), and
`expect_screen`, `expect_profiled`, `expect_untracked` and `expect_message`. `/help` lists
them and `/help <command>` gives its arguments; Up and Down bring back
earlier lines, and Esc closes it. Checks say whether they hold. `@n`
counts from where the last `/mark` was.

### Relative positions

Any coordinate can be written `~n`: `n` blocks from the player, along that
axis (`~` alone is 0). For commands about a block that's from the block
holding the player's feet, so `~ ~ ~-1` is the block they stand on and
`~4 ~ ~` the block 4 east of their feet; for `teleport`, `spawn` and
`expect_player` it's from the feet themselves. The player's position is
read when the command runs, so use them after `wait_loaded` (which lets the
player land) or after moving.

`@n` counts from the marked block instead: the block the player landed in
at the last `wait_loaded`, or where they were at the last `mark`. It stays
put when the player moves, so it's the way to check where they ended up:

    wait_loaded
    hold W 2
    expect_player @0.5 @2.5 @1      # two blocks north and one up from the start

    fill ~4 ~-2 ~ ~4 ~2 ~2 worldcraft:stone     # a wall 4 blocks east
    break ~4 ~ ~1
    expect ~4 ~ ~1 core:air

`demos/blocks.demo` is a worked example.

Key names are SDL's: `W`, `Space`, `Left Shift`, `Escape`, `Return`, `F1`,
`1`, and so on.
# Animated water and lava (#155): each texture is a strip of frames, top to
# bottom (assets/texture/animations.lua), swapped in as game time passes,
# on every face of every block of it. Still (source) and flowing blocks
# have textures, and animations, of their own: still water changes frame
# every 0.15 seconds, flowing every 0.1; lava every 0.3 and 0.2.
# worldcraft --demo demos/animated_fluids.demo --demo-out demo_out
seed 12345
mobs off
view 4
window 1280 720

wait_loaded
time 0.5

# A pool of water and a pool of lava, side by side, sunk into a stone yard.
fill ~1 ~-4 ~ ~8 ~4 ~4 core:air
fill ~1 ~-4 ~-2 ~8 ~4 ~-1 worldcraft:stone
fill ~2 ~-3 ~-1 ~7 ~-1 ~-1 worldcraft:water
fill ~2 ~1 ~-1 ~7 ~3 ~-1 worldcraft:lava
expect ~4 ~-2 ~-1 worldcraft:water
expect ~4 ~2 ~-1 worldcraft:lava

# Between them, a source of water on a pillar: it flows off the top every
# way and falls, in the flowing texture, which runs the way the water flows.
fill ~6 ~0 ~0 ~6 ~0 ~1 worldcraft:stone
setblock ~6 ~0 ~2 worldcraft:water
look 0 -40
wait 1
expect ~6 ~0 ~2 worldcraft:water
expect ~5 ~0 ~2 worldcraft:water[level=1]
expect ~7 ~0 ~2 worldcraft:water[level=1]
expect ~6 ~1 ~2 worldcraft:water[level=1]
expect ~5 ~0 ~1 worldcraft:water[falling]
screenshot fluids-1
wait 0.3
screenshot fluids-2
wait 2

# From above: each side of the pillar's top flows outwards.
mark
teleport @6.5 @0.5 @6
look 0 -89
wait 0.5
screenshot fluids-3-above

# On open ground, east of the yard, water spreads out in a diamond: the
# blocks between its arms flow diagonally, their texture turned to match.
record off
fill @10 @-9 @-1 @26 @9 @5 core:air
fill @10 @-9 @-1 @26 @9 @-1 worldcraft:stone
setblock @18 @0 @0 worldcraft:water
wait 4
record on
expect @19 @1 @0 worldcraft:water[level=2]
expect @17 @-1 @0 worldcraft:water[level=2]
teleport @18.5 @0.5 @18
look 0 -89
wait 1
screenshot fluids-4-diamond
# The block atlas's border: each texture's place has a border a pixel wide
# repeating its edge pixels, so a face drawn right to its texture's edges
# (tile UVs aren't pulled in, so texels line up with the face) can't pick up
# a neighbouring texture there, which showed as thin white lines along
# blocks' edges. Checked for block textures, an animated one (after its
# frames have changed) and a mob's skin, which spans several tiles.
# worldcraft --demo demos/atlas_padding.demo --demo-out demo_out
seed 1
mobs off
view 6
window 1280 720

wait_loaded
time 0.5
god on
fly on
mark

# High in the sky: a wall of stone with stripes of dirt and planks, and in
# front of it a stone platform with a basin of water and a cow.
record off
fill @40 @-25 @80 @40 @25 @105 worldcraft:stone
fill @40 @-20 @80 @40 @-18 @105 worldcraft:dirt
fill @40 @-8 @80 @40 @-6 @105 worldcraft:planks
fill @40 @6 @80 @40 @8 @105 worldcraft:dirt
fill @40 @18 @80 @40 @20 @105 worldcraft:planks
fill @24 @-3 @84 @33 @3 @84 worldcraft:stone
fill @28 @-2 @85 @32 @2 @85 worldcraft:stone
fill @29 @-1 @85 @31 @1 @85 worldcraft:water
record on
spawn worldcraft:cow @25.5 @0.5 @85
teleport @14.5 @0.5 @90
look 0 -8
wait 1
screenshot atlas-padding-1-wall
teleport @38.5 @0.5 @92
look 0 0
wait 0.5
screenshot atlas-padding-2-close

expect_atlas_border worldcraft:stone
expect_atlas_border worldcraft:dirt
expect_atlas_border worldcraft:planks
expect_atlas_border worldcraft:water
expect_atlas_border worldcraft:skin_cow
expect_gl_clean
# Block entities and uses from block data (#114): a crafting table's use
# opens a 3x3 grid; a crate's opens it. Neither is special-cased in code.
# worldcraft --demo demos/block_use.demo --demo-out demo_out
seed 12345
