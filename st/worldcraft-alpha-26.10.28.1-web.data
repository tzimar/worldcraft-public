local ui = require("worldcraft:menus")
return {
  components = {
    ui.inventory(),
    ui.hotbar {anchor = "bottom", at = {0, -4}},
  },
}local ui = require("worldcraft:menus")
return {
  components = {
   ui.inventory(),
    ui.panel {anchor = "top_right", at = {-40, 40}, padding = 6, children = {
      ui.text {text = "Large Chest"},
      ui.slots {at = {8, 26}, container = "chest", count = 80, columns = 8},
    }},
    ui.hotbar {anchor = "bottom", at = {0, -4}},
  },
