fill @100 @0 @0 @100 @0 @5 worldcraft:stone
teleport @100.5 @0.5 @6
# A: a clear line.
setblock @120 @-12 @0 worldcraft:torch[attach=floor]
# B: a glass wall across, with a way round its ends.
fill @118 @-6 @0 @118 @5 @4 worldcraft:glass
setblock @120 @0 @0 worldcraft:torch[attach=floor]
# C: an island of its own, cut off by a gap in the floor, with a wall across
