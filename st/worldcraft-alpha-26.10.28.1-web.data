# The debug overlay's profiling chart (F3): where each frame's time goes.
# worldcraft --demo demos/profile.demo --demo-out demo_out
seed 12345
window 1280 720

wait_loaded
time 0.5
look 30 -10
key F3
# Walk and turn, so chunks stream in and the chart has something to show.
key W down
wait 1.5
turn 300 0
wait 1.5
key W up
wait 1

# Every part of the frame is timed.
expect_profiled input
expect_profiled player
expect_profiled world
expect_profiled world/results
expect_profiled world/streaming
expect_profiled world/simulate
expect_profiled world/ticks
expect_profiled game
expect_profiled game/particles
expect_profiled game/projectiles
expect_profiled game/broken_blocks
expect_profiled game/pickup
expect_profiled game/spawner
expect_profiled game/mob_drops
expect_profiled game/clock
expect_profiled upload
expect_profiled render
expect_profiled render/setup
expect_profiled render/sky
expect_profiled render/chunks
expect_profiled render/entities
expect_profiled render/entities/mobs
expect_profiled render/entities/drops
expect_profiled render/entities/draw
expect_profiled render/water
expect_profiled render/overlays
expect_profiled ui
expect_profiled swap
# The phases cover the whole frame: nothing falls between them.
expect_untracked 0.001
# And the sections inside world and render cover nearly all of them.
expect_untracked 0.05 world
expect_untracked 0.05 render
screenshot profile-chart
