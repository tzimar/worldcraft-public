# alone) so that no other skeletons come out on it, and a pillar for the
# player to watch from, high enough that the skeletons don't notice them.
teleport @100.5 @0.5 @6
wait_loaded all
record off
# Air all round first, so nothing joins the floor.
fill @96 @-24 @-4 @130 @28 @9 core:air
