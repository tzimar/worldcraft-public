# Build with block commands, break a block, and check the results.
# worldcraft --demo demos/blocks.demo --demo-out demo_out
# ~ coordinates are relative to the block holding the player's feet; @ ones
# to the block they landed in after wait_loaded.
seed 12345
mobs off
view 4
window 1280 720

wait_loaded
time 0.5
look 0 -20
# Standing in the middle of the marked block, on the ground.
expect_player @0.5 @0.5 @0

# A stone wall 4 blocks ahead (+X), 5 wide and 3 high, with a log in the middle.
fill ~4 ~-2 ~ ~4 ~2 ~2 worldcraft:stone
setblock ~4 ~ ~1 worldcraft:log[oriented=z]
screenshot blocks-1-wall
expect ~4 ~ ~1 worldcraft:log
expect ~4 ~2 ~2 worldcraft:stone

# Break the log as the player would: the gap stays open and the log drops
# into it.
