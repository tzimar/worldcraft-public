# Shapes

A block that isn't a cube names a shape in its file's `shape` field (`assets/block/README.md`). `assets/shape/<namespace>/<name>.lua` is the shape `<namespace>:<name>` (`assets/shape/worldcraft/slab.lua` is `worldcraft:slab`). The shapes the game still draws itself (`fire`) are named without one.

A shape file returns a table:

| Field | |
|---|---|
| `bake` | A function, `bake(state)`, called once for each state of each block that has the shape, when the game loads, so nothing runs it while playing. It returns what that state looks like, below. |
| `full_cell` | `true` if the shape fills its whole cell: a block that needs support can rest against it. Default `false`. |
| `one_way` | `true` if a solid block of it only stops what comes down onto it from above (a platform). Default `false`. |
| `about` | A note on what it is. |

`state` is a table of the block's axes: an enum's value as a string (`state.facing == "north"`), a bool as a boolean (`state.lit`), an int as a number. It has only the axes the block has. `state.support_face` is the face (0-5) of the block it rests against, if it rests on one (`needs_support` blocks: torches, ladders, rope).

`bake` returns a table:

| Field | |
|---|---|
| `collision` | One or two boxes `{x0, y0, z0, x1, y1, z1}` within the cell (0 to 1), which a solid block of it fills. |
| `pick` | The boxes that can be pointed at and are outlined. Default: the collision boxes. |
| `faces` | The quads to draw, each `{pos = {{x, y, z} x 4}, uv = {{u, v} x 4}, texture = n, hidden = side, shade = s}`: its corners anticlockwise from outside; `uv` in pixels of the tile (0 to 16); `texture` the face (0-5: +X, -X, +Y, -Y, +Z, -Z) of the block whose texture it uses (a shape never has a texture of its own: the block's file says what it's made of); `hidden` a side of the cell (same numbers) it lies against, which leaves it out when an opaque block is there; `shade` how far it's turned from the light (1 a top, 0.5 a bottom). There's no limit to how many. |
| `holds_up` | The faces (0-5) a block that needs support can rest against, as a fence's top. Default none. |
| `tip` | `{x, y, z}` where flames and smoke come from. Default: the top middle of the first pick box. |

`require("worldcraft:shapes")` (`assets/lib/worldcraft/shapes.lua`) has `box_faces(box)`, the six faces of a box textured as a cube's are (leaving out those on the cell's sides when hidden), and `boxes_faces(boxes)`.

An error is logged, and the state is the whole cell, drawn as nothing.
return {
  about = "Two crossed diagonal quads showing the whole tile (flowers, plants).",
  bake = function(state)
    -- Inset slightly so the plant doesn't touch the cell's corners.
    local lo, hi = 0.15, 0.85
    local uv = {{0, 16}, {16, 16}, {16, 0}, {0, 0}}
    local faces = {}
    for _, d in ipairs({{{lo, lo}, {hi, hi}}, {{hi, lo}, {lo, hi}}}) do
      local ax, ay = d[1][1], d[1][2]
      local bx, by = d[2][1], d[2][2]
      -- Each drawn from both sides.
      table.insert(faces, {pos = {{ax, ay, 0}, {bx, by, 0}, {bx, by, 1}, {ax, ay, 1}}, uv = uv, texture = 0})
      table.insert(faces, {pos = {{bx, by, 0}, {ax, ay, 0}, {ax, ay, 1}, {bx, by, 1}}, uv = uv, texture = 0})
    end
    -- Pointed at in a box around the bottom of its stems, not its whole sprite.
    return {collision = {{0, 0, 0, 1, 1, 1}}, pick = {{0.3, 0.3, 0, 0.7, 0.7, 0.5}}, faces = faces}
  end,
}
-- A panel 3/16 thick filling its cell's height and width (a part of a
-- multi-part block, one cell of a two-high door). Closed, it stands against
-- the side of its cell towards whoever placed it (opposite its facing);
-- open, it has swung a quarter turn on its hinge, at the placer's left, to
-- stand against that side.
local T = 3 / 16

local FACING = {east = 0, west = 1, north = 2, south = 3}
-- Its left, looking the way it faces: a quarter turn anticlockwise.
local LEFT = {[0] = 2, 3, 1, 0}
-- How far each face is turned from the light, in face order.
local SHADE = {0.8, 0.8, 0.6, 0.6, 1.0, 0.5}

-- The panel's box, against the `side` (face 0-3) of its cell.
local function panel(side)
  local box = {0, 0, 0, 1, 1, 1}
  if side == 0 then
    box[1] = 1 - T
  elseif side == 1 then
    box[4] = T
  elseif side == 2 then
    box[2] = 1 - T
  else
    box[5] = T
  end
  return box
end

return {
  about = "Each part's textures are as the door stands facing east: its front and back on its east and west faces, the edges either side on its north and south, its ends on its top and bottom. The edges and ends are 3 pixels wide, the panel's thickness: the left of their tiles (pixels 0-3), lengthways down an edge and along an end.",
  bake = function(state)
    local facing = FACING[state.facing] or 0
    local side
    if state.open then
      side = LEFT[facing]
    else
      side = if facing % 2 == 0 then facing + 1 else facing - 1
    end
    local box = panel(side)
    local x0, y0, z0, x1, y1, z1 = box[1], box[2], box[3], box[4], box[5], box[6]
    -- Thin along x (its faces east and west), or along y.
    local thin_x = x1 - x0 < 0.5
    -- Corners per face (+X, -X, +Y, -Y, +Z, -Z), anticlockwise from outside.
    local corners = {
      {{x1, y0, z0}, {x1, y1, z0}, {x1, y1, z1}, {x1, y0, z1}},
      {{x0, y1, z0}, {x0, y0, z0}, {x0, y0, z1}, {x0, y1, z1}},
      {{x1, y1, z0}, {x0, y1, z0}, {x0, y1, z1}, {x1, y1, z1}},
      {{x0, y0, z0}, {x1, y0, z0}, {x1, y0, z1}, {x0, y0, z1}},
      {{x0, y0, z1}, {x1, y0, z1}, {x1, y1, z1}, {x0, y1, z1}},
      {{x0, y1, z0}, {x1, y1, z0}, {x1, y0, z0}, {x0, y0, z0}},
    }
    local on_side = {x1 >= 1, x0 <= 0, y1 >= 1, y0 <= 0, z1 >= 1, z0 <= 0}
    local faces = {}
    for f = 0, 5 do
      -- Where its two parts meet, there's nothing to see: the lower part
      -- leaves out its top, the upper its bottom.
      local meets = (f == 4 and state.part == 0) or (f == 5 and state.part == 1)
      if not meets then
        local finish = f >= 4
        local broad = not finish and (f < 2) == thin_x
        local texture
        if finish then
          texture = f
        else
          texture = (if broad then 0 else 2) + f % 2
        end
        local uv = {}
        for i, c in ipairs(corners[f + 1]) do
          -- Across the panel's width, and through its thickness (0 to 1).
          local across = if thin_x then c[2] else c[1]
          local through = if thin_x then (c[1] - x0) / T else (c[2] - y0) / T
          if broad then
            -- Facing out, the top of the tile up, as a cube's side.
            local u
            if f == 0 then
              u = c[2]
            elseif f == 1 then
              u = 1 - c[2]
            elseif f == 2 then
              u = 1 - c[1]
            else
              u = c[1]
            end
            uv[i] = {u * 16, (1 - c[3]) * 16}
          elseif finish then
            uv[i] = {through * 3, across * 16}
          else
            uv[i] = {through * 3, (1 - c[3]) * 16}
          end
        end
        table.insert(faces, {
          pos = corners[f + 1],
          uv = uv,
          texture = texture,
          hidden = if on_side[f + 1] then f else nil,
          shade = SHADE[f + 1],
        })
      end
    end
    return {collision = {box}, faces = faces}
  end,
}
local shapes = require("worldcraft:shapes")

local P = 1 / 16
local POST_LO = 6 * P
local POST_HI = 10 * P
-- Two rails (pixels 6-9 and 12-15 up), 2 pixels wide, out to each side it's connected on.
local RAILS = {{6 * P, 9 * P}, {12 * P, 15 * P}}
local HALF_WIDTH = P

-- A rail's box from the post out to the side of the cell (faces 0-3), between two heights.
local function arm(face, lo_z, hi_z)
  local w_lo = 0.5 - HALF_WIDTH
  local w_hi = 0.5 + HALF_WIDTH
  if face == 0 then
    return {POST_HI, w_lo, lo_z, 1, w_hi, hi_z}
  elseif face == 1 then
    return {0, w_lo, lo_z, POST_LO, w_hi, hi_z}
  elseif face == 2 then
    return {w_lo, POST_HI, lo_z, w_hi, 1, hi_z}
  end
  return {w_lo, 0, lo_z, w_hi, POST_LO, hi_z}
end

-- The post's box, `height` tall, stretched out to each side it's connected
-- on: a plus, as one box along X and (if it's connected north or south) one along Y.
local function plus(state, height)
  local boxes = {{
    if state.west then 0 else POST_LO, POST_LO, 0,
    if state.east then 1 else POST_HI, POST_HI, height,
  }}
  if state.north or state.south then
    table.insert(boxes, {
      POST_LO, if state.south then 0 else POST_LO, 0,
      POST_HI, if state.north then 1 else POST_HI, height,
    })
  end
  return boxes
end

return {
  about = "A 4x4-pixel post with rails out to the sides it's joined on (the block's connects field).",
  bake = function(state)
    local faces = shapes.box_faces({POST_LO, POST_LO, 0, POST_HI, POST_HI, 1})
    local connected = {state.east, state.west, state.north, state.south}
    for face = 0, 3 do
      if connected[face + 1] then
        for _, rail in ipairs(RAILS) do
          shapes.box_faces(arm(face, rail[1], rail[2]), faces)
        end
      end
    end
    -- Pointed at up to the top of its post; collides half a block higher,
    -- so it can't be jumped over. Only its post's top holds anything up (a
    -- torch); its sides are too thin.
    return {collision = plus(state, 1.5), pick = plus(state, 1), faces = faces, holds_up = {4}}
  end,
}
local shapes = require("worldcraft:shapes")

local PX = 1 / 16

return {
  about = "A board one pixel thick against its support face (ladders).",
  bake = function(state)
    local box = {0, 0, 0, 1, 1, 1}
    local face = state.support_face
    if face == 0 then
      box[1] = 1 - PX
    elseif face == 1 then
      box[4] = PX
    elseif face == 2 then
      box[2] = 1 - PX
    elseif face == 3 then
      box[5] = PX
    elseif face == 4 then
      box[3] = 1 - PX
    else
      box[6] = PX
    end
    return {collision = {box}, faces = shapes.box_faces(box)}
  end,
}
local shapes = require("worldcraft:shapes")

local PX = 1 / 16
-- Face directions on the ground (0-3: +X, -X, +Y, -Y).
local DIRECTION = {{1, 0}, {-1, 0}, {0, 1}, {0, -1}}
local BRACED = {"braced_east", "braced_west", "braced_north", "braced_south"}

local function sub(a, b)
  return {a[1] - b[1], a[2] - b[2], a[3] - b[3]}
end

local function add(a, b)
  return {a[1] + b[1], a[2] + b[2], a[3] + b[3]}
end

local function scale(a, s)
  return {a[1] * s, a[2] * s, a[3] * s}
end

local function dot(a, b)
  return a[1] * b[1] + a[2] * b[2] + a[3] * b[3]
end

local function cross(a, b)
  return {a[2] * b[3] - a[3] * b[2], a[3] * b[1] - a[1] * b[3], a[1] * b[2] - a[2] * b[1]}
end

local function normalize(a)
  return scale(a, 1 / math.sqrt(dot(a, a)))
end

-- A square beam `width` thick from `a` to `b`, its sides facing along `side`
-- (horizontal, across the beam) and the other way round it, drawn with the
-- 2-pixel middle strip of the block's top texture, `a` at the tile's bottom.
-- Its ends are left open.
local function beam(out, a, b, side, width)
  local along = normalize(sub(b, a))
  local w = scale(side, width * 0.5)
  local n = scale(normalize(cross(along, side)), width * 0.5)
  local length = math.min(16, math.sqrt(dot(sub(b, a), sub(b, a))) * 16)
  local offsets = {n, w, scale(n, -1), scale(w, -1)}
  for f = 0, 3 do
    local out_dir = offsets[f + 1]
    local across = offsets[(f + 1) % 4 + 1]
    local q = {
      sub(add(a, out_dir), across),
      add(add(a, out_dir), across),
      add(add(b, out_dir), across),
      sub(add(b, out_dir), across),
    }
    local uv = {{7, length}, {9, length}, {9, 0}, {7, 0}}
    -- Anticlockwise seen from outside.
    if dot(cross(sub(q[2], q[1]), sub(q[4], q[1])), out_dir) < 0 then
      q[2], q[4] = q[4], q[2]
      uv[2], uv[4] = uv[4], uv[2]
    end
    table.insert(out, {pos = q, uv = uv, texture = 4, shade = if f == 0 then 1.0 else 0.8})
  end
end

-- A platform's braces against the wall on `face` (0-3): two diagonal struts
-- from the wall up to the board's underside, near its ends. `skip` leaves
-- some out, by the way they are along the wall: bit 1 the one towards the
-- negative end, bit 2 the one towards the positive.
local function braces(out, face, skip)
  local wall = {DIRECTION[face + 1][1], DIRECTION[face + 1][2], 0}
  local side = {math.abs(wall[2]), math.abs(wall[1]), 0}
  -- The wall's plane, through the middle of the cell's face against it
  -- (just into the wall, so a strut's end doesn't show).
  local on_wall = add({0.5, 0.5, 0}, scale(wall, 0.5 + 0.55 * PX))
  for _, s in ipairs({-5.5 * PX, 5.5 * PX}) do
    if bit32.band(skip, if s < 0 then 1 else 2) == 0 then
      local along = scale(side, s)
      local a = add(add(on_wall, along), {0, 0, 4 * PX})
      local b = add(add(sub(on_wall, scale(wall, 11 * PX)), along), {0, 0, 15 * PX})
      beam(out, a, b, side, 2 * PX)
    end
  end
end

return {
  about = "A board two pixels thick across the top of the cell, braced by diagonal struts against the walls its braced_ axes name (kept by the block rule braced_platform).",
  one_way = true,
  bake = function(state)
    local board = {0, 0, 1 - 2 * PX, 1, 1, 1}
    local faces = shapes.box_faces(board)
    local braced = {}
    for face = 0, 3 do
      braced[face] = state[BRACED[face + 1]] == true
    end
    -- In a corner, braced on both walls, the strut on each wall nearest the
    -- other would overlap that wall's: neither is drawn (with a braced wall
    -- at each end, both of a wall's struts).
    for face = 0, 3 do
      if braced[face] then
        local d = DIRECTION[face + 1]
        local skip = 0
        for other = 0, 3 do
          local o = DIRECTION[other + 1]
          if braced[other] and o[1] * d[1] + o[2] * d[2] == 0 then
            skip = bit32.bor(skip, if o[1] + o[2] < 0 then 1 else 2)
          end
        end
        braces(faces, face, skip)
      end
    end
    return {collision = {board}, faces = faces}
  end,
}
-- A 2x10-pixel post standing in the middle of the cell. Against a wall
-- (support face horizontal) it leans out from the wall at 22.5 degrees with
-- its foot on the wall, like a wall-mounted torch. It's built around its
-- foot at the origin, then placed (and tilted) in its cell.
local P = 1 / 16
local LO = {-P, -P, 0}
local HI = {P, P, 10 * P}
local TILT = 0.3926991

-- Where the foot goes, which way the wall is, and the tilt.
local function placement(support)
  local pp = {foot = {0.5, 0.5, 0}, wall = {0, 0}, cos = 1, sin = 0}
  if support ~= nil and support < 4 then
    local wall = ({{1, 0}, {-1, 0}, {0, 1}, {0, -1}})[support + 1]
    pp.wall = wall
    pp.foot = {0.5 + wall[1] * (0.5 - P), 0.5 + wall[2] * (0.5 - P), 3.5 * P}
    pp.cos = math.cos(TILT)
    pp.sin = math.sin(TILT)
  end
  return pp
end

-- Rotate in the vertical plane through the wall normal so the top leans
-- away from the wall; the foot stays put.
local function place(pp, v)
  local along = v[1] * pp.wall[1] + v[2] * pp.wall[2]
  local across_x = v[1] - along * pp.wall[1]
  local across_y = v[2] - along * pp.wall[2]
  local along_r = along * pp.cos - v[3] * pp.sin
  local up_r = along * pp.sin + v[3] * pp.cos
  return {pp.foot[1] + across_x + pp.wall[1] * along_r, pp.foot[2] + across_y + pp.wall[2] * along_r, pp.foot[3] + up_r}
end

return {
  about = "A thin 2x10 post in the middle of the tile (torches), leaning against its support face when that's a wall.",
  bake = function(state)
    local pp = placement(state.support_face)
    local function placed(corners)
      local out = {}
      for i, c in ipairs(corners) do
        out[i] = place(pp, c)
      end
      return out
    end

    -- Around the corners of the placed post.
    local lo = {1, 1, 1}
    local hi = {0, 0, 0}
    for i = 0, 7 do
      local c = place(pp, {
        if i % 2 >= 1 then HI[1] else LO[1],
        if math.floor(i / 2) % 2 >= 1 then HI[2] else LO[2],
        if i >= 4 then HI[3] else LO[3],
      })
      for k = 1, 3 do
        lo[k] = math.min(lo[k], c[k])
        hi[k] = math.max(hi[k], c[k])
      end
    end

    -- The tile's centre column (x 7-9): sides use rows 6-16 (flame at the
    -- top), the top rows 6-8 (flame), the bottom rows 14-16 (stick).
    local side_uv = {{7, 16}, {9, 16}, {9, 6}, {7, 6}}
    local x0, y0, z0 = LO[1], LO[2], LO[3]
    local x1, y1, z1 = HI[1], HI[2], HI[3]
    local faces = {}
    for _, corners in ipairs({
      {{x1, y0, z0}, {x1, y1, z0}, {x1, y1, z1}, {x1, y0, z1}},
      {{x0, y1, z0}, {x0, y0, z0}, {x0, y0, z1}, {x0, y1, z1}},
      {{x1, y1, z0}, {x0, y1, z0}, {x0, y1, z1}, {x1, y1, z1}},
      {{x0, y0, z0}, {x1, y0, z0}, {x1, y0, z1}, {x0, y0, z1}},
    }) do
      table.insert(faces, {pos = placed(corners), uv = side_uv, texture = 0})
    end
    table.insert(faces, {
      pos = placed({{x0, y0, z1}, {x1, y0, z1}, {x1, y1, z1}, {x0, y1, z1}}),
      uv = {{7, 8}, {9, 8}, {9, 6}, {7, 6}},
      texture = 0,
    })
    table.insert(faces, {
      pos = placed({{x0, y1, z0}, {x1, y1, z0}, {x1, y0, z0}, {x0, y0, z0}}),
      uv = {{7, 16}, {9, 16}, {9, 14}, {7, 14}},
      texture = 0,
    })

    -- The middle of the top of the post: a torch's flame.
    return {collision = {{0, 0, 0, 1, 1, 1}}, pick = {{lo[1], lo[2], lo[3], hi[1], hi[2], hi[3]}}, faces = faces, tip = place(pp, {0, 0, HI[3]})}
  end,
}
local shapes = require("worldcraft:shapes")

local PX = 1 / 16

return {
  about = "A strand two pixels thick down the middle of the cell, tied near the top to a wall it hangs on; more of it can hang from its bottom (rope).",
  bake = function(state)
    -- The strand down the middle; tied to a wall, it stops short of the top,
    -- where a tie runs from it to the wall.
    local strand = {7 * PX, 7 * PX, 0, 9 * PX, 9 * PX, 1}
    local boxes = {strand}
    local tie
    local face = state.support_face
    if face ~= nil and face < 4 then
      strand[6] = 14 * PX
      tie = {7 * PX, 7 * PX, 12 * PX, 9 * PX, 9 * PX, 14 * PX}
      if face == 0 then
        tie[1], tie[4] = 9 * PX, 1
      elseif face == 1 then
        tie[1], tie[4] = 0, 7 * PX
      elseif face == 2 then
        tie[2], tie[5] = 9 * PX, 1
      else
        tie[2], tie[5] = 0, 7 * PX
      end
      table.insert(boxes, tie)
    end

    -- Pointed at as rope's boxes, 6 pixels thick (like a plant's): the
    -- strand 6 across, and a tie 6 across and 6 high, up to the top of the cell.
    local pick = {{5 * PX, 5 * PX, 0, 11 * PX, 11 * PX, 1}}
    if tie ~= nil then
      local fat = {tie[1], tie[2], 10 * PX, tie[4], tie[5], 1}
      if tie[4] - tie[1] < tie[5] - tie[2] then
        fat[1], fat[4] = 5 * PX, 11 * PX
      else
        fat[2], fat[5] = 5 * PX, 11 * PX
      end
      table.insert(pick, fat)
    end
    -- Rope hangs from the bottom of rope.
    return {collision = boxes, pick = pick, faces = shapes.boxes_faces(boxes), holds_up = {5}}
  end,
}
local shapes = require("worldcraft:shapes")

return {
  about = "The bottom half of the cell (slabs).",
  bake = function(state)
    local box = {0, 0, 0, 1, 1, 0.5}
    return {collision = {box}, faces = shapes.box_faces(box)}
  end,
}
local shapes = require("worldcraft:shapes")

return {
  about = "The bottom 2/16 of the cell (snow lying on a block).",
  bake = function(state)
    local box = {0, 0, 0, 1, 1, 2 / 16}
    return {collision = {box}, faces = shapes.box_faces(box)}
  end,
}
local shapes = require("worldcraft:shapes")

return {
  about = "A slab with a step on its back half: the half towards its facing (you walk up stairs the way they face).",
  bake = function(state)
    local boxes = {{0, 0, 0, 1, 1, 0.5}}
    if state.facing ~= nil then
      local step = {0, 0, 0.5, 1, 1, 1}
      if state.facing == "east" then
        step[1] = 0.5
      elseif state.facing == "west" then
        step[4] = 0.5
      elseif state.facing == "north" then
        step[2] = 0.5
      else
        step[5] = 0.5
      end
      table.insert(boxes, step)
    end
    return {collision = boxes, faces = shapes.boxes_faces(boxes)}
  end,
}
local shapes = require("worldcraft:shapes")

local FACING = {east = 1, west = 3, north = 0, south = 2}

local TOP = 2 / 16
local LEG = 2 / 16

return {
  about = "A board two pixels thick across the top of the cell, on a leg two pixels square at each corner. It collides as its whole cell (tables).",
  bake = function(state)
    local under = 1 - TOP
    -- Only the top's upper face can be hidden (by a block on it); the legs show.
    local faces = shapes.box_faces({0, 0, under, 1, 1, 1}, nil, {[4] = true})
    local f = FACING[state.facing]
    for i, leg in ipairs({
      {0, 0, 0, LEG, LEG, under},           -- south west
      {1 - LEG, 0, 0, 1, LEG, under},       -- east south
      {0, 1 - LEG, 0, LEG, 1, under},       -- west north
      {1 - LEG, 1 - LEG, 0, 1, 1, under},   -- east north
    }) do
        if
            true
            and (false
            or (f == 0 and ((i-1)%2 == state.part))
            or (f == 1 and ((i-1)//2 ~= state.part))
            or (f == 2 and ((i-1)%2 ~= state.part))
            or (f == 3 and ((i-1)//2 == state.part))
            )
        then
        shapes.box_faces(leg, faces, {})
        end
    end
    return {collision = {{0, 0, 0, 1, 1, 1}}, faces = faces}
  end,
}
return {
  ["worldcraft:water"] = {
    frame_time = 0.15,
  },
  ["worldcraft:water_flow"] = {
    frame_time = 0.1,
  },
  ["worldcraft:lava"] = {
    frame_time = 0.3,
  },
  ["worldcraft:lava_flow"] = {
    frame_time = 0.2,
  },
  ["worldcraft:fire"] = {
    frame_time = 0.05,
  },
}
