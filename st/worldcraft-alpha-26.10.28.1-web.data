-- Families of blocks made of one material: require("worldcraft:blocks").

local blocks = {}

-- What a block made of each is like: its texture, how hard it is, what
-- mines it quickly, and whether it burns.
blocks.ROCK = {texture = "worldcraft:rock", hardness = 1.5, mineable = "pickaxe"}
blocks.WOOD = {texture = "worldcraft:planks", hardness = 1.0, mineable = "axe", flammable = true}

local function made_of(material, block)
  block.textures = material.texture
  block.hardness = material.hardness
  block.mineable = material.mineable
  if material.flammable then
    block.tags = {"flammable"}
  end
  return block
end

-- Stairs, turned to face away from whoever places them.
function blocks.stairs(material)
  return made_of(material, {flags = {"solid"}, shape = "worldcraft:stairs", placed = "facing"})
end

-- A half-height slab.
function blocks.slab(material)
  return made_of(material, {flags = {"solid"}, shape = "worldcraft:slab"})
end

return blocks
-- Uses for healing items: require("worldcraft:healing").

local healing = {}

-- Heals `hp` over `seconds`, used up. Refused at full health, and while
-- healing with as much left to give is under way (a Bandage on a Bandage).
function healing.over_time(hp, seconds)
  return function(ctx)
    if not ctx.player:heal_over_time(hp, seconds) then
      return false
    end
    ctx.item:take(1)
    return true
  end
end

-- Food: heals `hp` at once, up to full, eaten. Not eaten at full health.
function healing.food(hp)
  return function(ctx)
    if ctx.player:heal(hp) <= 0 then
      return false
    end
    ctx.item:take(1)
    return true
  end
end

return healing
-- Making a menu's components (assets/menu/README.md).
--
-- A menu is a tree: leaves (text, buttons, slots, icons) in containers
-- (rows, columns, grids, stacks). The game lays the tree out when it's
-- drawn, from the sizes things have then, so nothing here works out a
-- position. Each function takes the component's table and gives it back
-- marked with its kind, so `ui.button {...}` is a button, and a misspelt
-- one is an error.
--
-- The inventory, a crafting grid, the hotbar and a meter are trees made by
-- the functions at the end; a menu file can make its own the same way.
local ui = {}

local function kind(name)
  return function(t)
    t.kind = name
    return t
  end
end

ui.text = kind("text")
ui.button = kind("button")
ui.slot = kind("slot")
ui.slots = kind("slots")
ui.progress = kind("progress")
ui.icon = kind("icon")
ui.lines = kind("lines")
ui.line = kind("line")
ui.row = kind("row")
ui.column = kind("column")
ui.grid = kind("grid")
ui.stack = kind("stack")

-- A column on a panel's background.
function ui.panel(t)
  t.kind = "column"
  t.background = "panel"
  return t
end

-- The player's inventory: a line, its rows (the "backpack" container) in
-- rows of `columns` (10 if not given), a line, and the hotbar.
function ui.inventory(c)
  return ui.row {anchor = "top_left", at = {40, 40}, gap = 8, children = {
    ui.column { gap = 8, children = {
      ui.panel {padding = 6, children = {
        ui.column {gap = 4, children = {
          ui.slots {container = "backpack", columns = 4},
        }},
      }},
      ui.panel {padding = 6, children = {
        ui.text {text = "Money"},
        ui.slots {container = "coins"},
      }}
    }},
    ui.panel {padding = 6, children = {ui.crafting {size = (c or 2)}}},
  }}
end

-- A crafting grid, `size` 2 or 3 (of the "crafting_grid" container: 3 by
-- 3, a row at a time; a 2 by 2 grid is its top left), an arrow, and its
-- output (the "crafting" container's one slot).
function ui.crafting(t)
  local size = t.size or 2
  local cells = {}
  for y = 0, size - 1 do
    for x = 0, size - 1 do
      table.insert(cells, ui.slot {container = "crafting_grid", index = y * 3 + x + 1})
    end
  end
  return ui.row {at = t.at, anchor = t.anchor, shown = t.shown, offset = t.offset, align = "center", gap = 13, children = {
    ui.grid {columns = size, gap = 2, children = cells},
    ui.text {text = "=>", scale = 1},
    ui.slot {container = "crafting", index = 1},
  }}
end

-- The hotbar on a panel, the hand's slot selected.
function ui.hotbar(t)
  return ui.row {at = t.at, anchor = t.anchor, shown = t.shown, offset = t.offset, background = "panel", padding = 6,
    children = {ui.slots {container = "hotbar"}}}
end

-- A row of `count` icons (10 if not given), 2 pixels apart, showing `value`
-- out of `max` (both values, by name): an `icon` for each `per` of it (over
-- `empty_icon`, if there is one), in halves if `halves`; from the right if
-- `align` is "right"; only while it's short of its most if `hide_full`.
-- Icons past its most aren't shown.
function ui.meter(t)
  local n = t.count or 10
  local per = t.per or 1
  local icons = {}
  for i = 0, n - 1 do
    local one = {}
    if t.empty_icon then
      table.insert(one, ui.icon {icon = t.empty_icon})
    end
    table.insert(one, ui.icon {icon = t.icon, value = t.value, from = i * per, per = per, halves = t.halves})
    local cell = ui.stack {shown = string.format("%s > %s", t.max, i * per), children = one}
    if t.align == "right" then
      table.insert(icons, 1, cell)
    else
      table.insert(icons, cell)
    end
  end
  return ui.row {at = t.at, anchor = t.anchor, offset = t.offset, gap = 2, children = icons,
    shown = t.hide_full and string.format("%s < %s", t.value, t.max) or t.shown}
end

return ui
-- Helpers for shape files (assets/shape/README.md): boxes and the faces they draw.
local M = {}

-- How far each face is turned from the light, in face order: +X, -X, +Y, -Y, +Z, -Z.
local SHADE = {0.8, 0.8, 0.6, 0.6, 1.0, 0.5}

-- The six faces of a box {x0, y0, z0, x1, y1, z1}, each textured with the
-- part of the block's tile for that face it covers, as a cube's are. A face
-- lying on the side of the cell is left out when an opaque block is there:
-- only those sides with `hide[side]` true, if `hide` is given. `out` is a
-- list to add them to; it's returned.
function M.box_faces(box, out, hide)
  out = out or {}
  local x0, y0, z0, x1, y1, z1 = box[1], box[2], box[3], box[4], box[5], box[6]
  -- Corners per face, anticlockwise from outside.
  local corners = {
    {{x1, y0, z0}, {x1, y1, z0}, {x1, y1, z1}, {x1, y0, z1}},
    {{x0, y1, z0}, {x0, y0, z0}, {x0, y0, z1}, {x0, y1, z1}},
    {{x1, y1, z0}, {x0, y1, z0}, {x0, y1, z1}, {x1, y1, z1}},
    {{x0, y0, z0}, {x1, y0, z0}, {x1, y0, z1}, {x0, y0, z1}},
    {{x0, y0, z1}, {x1, y0, z1}, {x1, y1, z1}, {x0, y1, z1}},
    {{x0, y1, z0}, {x1, y1, z0}, {x1, y0, z0}, {x0, y0, z0}},
  }
  local on_side = {x1 >= 1, x0 <= 0, y1 >= 1, y0 <= 0, z1 >= 1, z0 <= 0}
  for f = 0, 5 do
    local uv = {}
    for i, c in ipairs(corners[f + 1]) do
      local u
      if f == 0 then
        u = c[2]
      elseif f == 1 then
        u = 1 - c[2]
      elseif f == 2 then
        u = 1 - c[1]
      else
        u = c[1]
      end
      local v = if f >= 4 then 1 - c[2] else 1 - c[3]
      uv[i] = {u * 16, v * 16}
    end
    table.insert(out, {
      pos = corners[f + 1],
      uv = uv,
      texture = f,
      hidden = if on_side[f + 1] and (hide == nil or hide[f]) then f else nil,
      shade = SHADE[f + 1],
    })
  end
  return out
end

-- The faces of each of a list of boxes.
function M.boxes_faces(boxes, out)
  out = out or {}
  for _, box in ipairs(boxes) do
    M.box_faces(box, out)
  end
  return out
end

return M
# Menus

The screens that open over the world (the inventory, a furnace's, a chest's, a merchant's shop, the settings, the death screen) are menu files: `assets/menu/<namespace>/<name>.lua` is the menu `<namespace>:<name>` (`assets/menu/worldcraft/death.lua` is `worldcraft:death`). The plan is `docs/plans/lua-menus.md`.

A menu is usually a panel of a set size, centred across the window and a little above the middle, holding components placed by pixel position in it; its components can also be placed from a point of the window (their `anchor`, below), so a menu can put things down the side of the window or along the bottom, with or without a panel in the middle. Inside those, things are laid out by the game. Nothing in the file runs while the menu's open but its functions (a button's `on_click`, a slot's `on_change`, `on_open`, `on_close`), when that happens.

A block's `use` opens a menu on the block: `ctx.block:open_menu("worldcraft:furnace")` (`assets/block/README.md`). Its slots then show that block's: the furnace's own. A merchant's shop opens on the merchant.

A menu file returns a table:

| Field | |
|---|---|
| `size` | `{width, height}`: the panel's size, in pixels. Without one, the menu has no panel, and each of its components needs an `anchor`. |
| `components` | Its components (below), in the order they're drawn. |
| `title` | Drawn in the panel's top left. Default none. |
| `on_open` | A function run as the menu opens, with the ctx below (`ctx.block` or `ctx.npc` for what it's open on). |
| `on_close` | A function run as it closes, however it does (a button, Esc, the thing going away). |
| `closable` | `false` if Esc doesn't close it (the death menu). Default `true`. |
| `tint` | `{red, green, blue, alpha}` (0 to 1) over the whole window behind the panel: the death menu's red. Default none. |
| `style` | How it's drawn: `"default"` is the only style there is so far. |
| `about` | A note on what it is. |

## Components

A menu is a tree of components: leaves (text, buttons, slots, icons) in containers (rows, columns, grids, stacks). Make them with `require("worldcraft:menus")` (`assets/lib/worldcraft/menus.lua`): `ui.text {...}`, `ui.row {...}` and so on, which mark each table with its kind.

The menu's own components (those in `components`) are placed by pixel position, or from a point of the window. Everything inside them is laid out by the game when the menu's drawn, a little like CSS's flexbox, from the sizes things have then: a value's text, however many coins the inventory has. Nothing in Lua works out a position.

### Leaves

| Component | Fields |
|---|---|
| `text` | `text`, or `value`: one of the game's values (below), shown in `format` (`"View: {} chunks"`, `"{:.2f}"`: C++'s `std::format`; default `"{}"`); `scale` (2 is the menus' text, 1 half that); `color` (`{r, g, b}` or `"#rrggbb"`; default dark in a menu, white in the HUD); `shadow = true` for a drop shadow; `align` (`"left"`, `"center"` or `"right"`) for where it sits in a box bigger than it (its `size`, or stretched). Each character is 6 pixels across and 8 high, times its scale. |
| `button` | `label`, and `on_click`, a function (needed): what clicking it does. As big as its label, and 16 pixels wider, by 22, unless given a `size`. |
| `slot` | One slot of a `container` (below): `index`, its number (from 1) or its name (`"fuel"`). 36 pixels square. `on_change(ctx, slot)`, a function, runs after a click changes it, given its number (from 1). |
| `slots` | A `container`'s slots, in rows of `columns` (one row if not given), `gap` apart (default 2): from slot `from` (default 1), `count` of them (default the rest: however many the container has when the menu's drawn, which may be none, when they take no room). `on_change` as for a slot. |
| `progress` | A bar of `size` showing a `value` from 0 to 1, filling left to right, its `label` above it, small. |
| `icon` | A texture (`icon = "worldcraft:heart"`), 18 pixels square unless given a `size`. With a `value`, it shows `per` (default 1) of it from `from` (default 0): whole at `from + per` or more, nothing at `from` or less (but still taking its room), and in between part of it from the left (with `halves = true`, the left half). |
| `lines` | A `value`'s lines of text (text with a line break between lines) on a dark box, as big as they are. |
| `line` | A line, 2 pixels thick, across whatever holds it (the inventory's separators). With a `size`, that size. |

A slot is 36 pixels square. A click picks up a stack onto the cursor, or puts down, merges or swaps the one held; a right click picks up the larger half, or puts down one. A click off the menu (not on a panel, slot or button) throws the stack held.

### Containers

| Component | |
|---|---|
| `row` | Its `children` left to right. |
| `column` | Top to bottom. |
| `grid` | In rows of `columns` (default 1), each in a cell the size of the largest. |
| `stack` | All in the same place, the first underneath (an empty heart under a full one). |
| `ui.panel {...}` | A column with `background = "panel"`. |

Each container has:

| Field | |
|---|---|
| `gap` | Pixels between its children (and a grid's rows). |
| `padding` | Pixels round its children, inside it: a number, `{across, down}`, or `{left, top, right, bottom}`. |
| `align` | Where its children go across it (up and down, in a row): `"start"` (default), `"center"`, `"end"`, or `"stretch"`, as big as it is that way (those without a size that way). In a grid, where each goes in its cell; in a stack, both ways. |
| `justify` | Where they go along it, when it's bigger than they need: `"start"` (default), `"center"`, `"end"`, or `"space_between"`, the room left over shared out between them. |
| `background` | `"panel"`: drawn on a panel's background. Default none. |

A container is as big as what it holds, and its padding, unless given a `size`; either of `size`'s numbers can be 0, for its content's that way. In a row (or column), a child with `grow` takes room left over that way: all of it, or shared with the others that grow, by how much each grows. A child shown only while something's true (`shown`, below) takes no room while it isn't.

### Made of those

Functions in the same library give back trees of them, passing on `at`, `anchor`, `shown` and `offset`:

| Function | |
|---|---|
| `ui.inventory {columns = 10}` | The player's rows (`backpack`) in rows of `columns`, and the hotbar (`hotbar`) below them, between lines: 378 by 167 pixels at 10 across. `on_change` goes to their slots. |
| `ui.crafting {size = 2}` | A crafting grid of `size` 2 or 3 (`crafting_grid`'s slots, given back when the menu closes), an arrow, and its output (`crafting`), which a click crafts onto the cursor. |
| `ui.hotbar {}` | The hotbar's slots on a panel, the hand's slot drawn as selected: 390 by 48 pixels. |
| `ui.meter {...}` | A row of `count` (default 10) icons, 2 pixels apart, showing `value` out of `max` (both values' names): an `icon` for each `per` (default 1) of it, over `empty_icon` if it has one, in halves with `halves = true`. With `align = "right"`, they fill from the right; with `hide_full = true`, they're hidden while the value's at its most (breath). Icons past `max` aren't shown. |

A menu file can make its own the same way: a function that gives back a tree.

### Placing them

A menu's own component has `at` (`{x, y}`, pixels): its top left from its panel's. Or it has an `anchor`: a point of the window, and the same point of the component, which `at` moves it from: `top_left`, `top`, `top_right`, `left`, `center`, `right`, `bottom_left`, `bottom` or `bottom_right`. `anchor = "bottom", at = {0, -4}` puts it in the middle, 4 pixels above the bottom edge. A component in the panel that's outside it is a warning, and so is `at` or `anchor` on one inside a container.

Any component can have `offset` (`{x, y}`): moved that far once it's laid out, with what it holds, without moving anything else.

The inventory's rows 4 across with the coin slots under them, on a panel in the top left; a crafting grid on a panel beside it; and the hotbar along the bottom, where it can be clicked (the HUD's can't). The first panel is as big as its rows and coins, whatever the coins:

```lua
local ui = require("worldcraft:menus")
return {
  components = {
    ui.row {anchor = "top_left", at = {40, 40}, gap = 4, children = {
      ui.panel {padding = 6, children = {
        ui.column {gap = 4, children = {
          ui.slots {container = "backpack", columns = 4},
          ui.slots {container = "coins"},
        }},
      }},
      ui.panel {padding = 6, children = {ui.crafting {size = 2}}},
    }},
    ui.hotbar {anchor = "bottom", at = {0, -4}},
  },
}
```

Every component can have `shown`: it's drawn (and laid out) only while that's true. It's a value's name (true while it's not 0, `false` or empty), or a value compared with another or with a number: `"air < max_air"`, `"max_health > 4"` (`<`, `<=`, `>`, `>=`, `==`, `~=`). `"<container>.slots"` is how many slots a container has: `"shop.slots > 0"` while the shop has wares. Every component also has `style`.

## What a button does

`on_click(ctx)` gets the ctx every hook does (`ctx.player`, `ctx.world`: `assets/types/worldcraft.d.luau`), and:

| | |
|---|---|
| `ctx.menu:close()` | Close the menu, once the function's done. |
| `ctx.menu:open(name)` | Open another menu in its place, once the function's done; `false` if there's none called that. |
| `ctx.menu:set(name, value)`, `:get(name)` | One of the menu's own values (a number, text or boolean), kept while it's open (`nil` from `get` until set). A text shows it as `value = "menu.<name>"`. |
| `ctx.player:respawn()` | Bring the player back to life at their spawn point. |
| `ctx.npc` | In a menu open on an NPC (a merchant's shop), what an NPC's `talk` has (`assets/npc/README.md`), and `ctx.npc:talk()`: it says a line, as when it's right-clicked without a coin (its `talk`, then its `dialogue`). |
| `ctx.game:save()` | Save the world now. |
| `ctx.game:quit()` | Save and quit, once the function's done. |
| `ctx.settings:get(name)` | A number setting. |
| `ctx.settings:step(name, by)` | Change a number setting by `by`, rounded to a whole number of steps (so 0.01s don't drift) and kept in its range. `settings.cfg` is saved when the menu closes. |

## Values

What a `value` (or `shown`) can be, read each frame the menu's open:

| Value | |
|---|---|
| `view_distance`, `view_vertical`, `simulation_distance`, `day_length_minutes`, `fov`, `mouse_sensitivity` | The number settings (`settings.cfg`), which `ctx.settings` changes. |
| `furnace.progress` | 0 to 1 through cooking the next ingredient, in a menu open on a furnace. |
| `npc.full_name` | "Jenny the Nurse", in a menu open on an NPC. |

## Containers

What slots hold is the game's, by container. The menu reads them while it's open, and a click writes back what it changed.

| Container | Slots |
|---|---|
| `hotbar` | The player's hotbar, the hand's slot drawn as selected. Its size is `hotbar` in `assets/config/worldcraft/inventory.lua` (10). |
| `backpack` | The rest of the player's inventory: the rows above the hotbar. Its size is `backpack` in the same file (30). |
| `crafting_grid` | The player's crafting grid: 3 by 3, a row at a time (1-3, 4-6, 7-9); a 2 by 2 grid is its top left (1, 2, 4, 5). A menu showing slot 3, 6, 7, 8 or 9 of it crafts 3 by 3, otherwise 2 by 2. |
| `crafting` | One: the output of the menu's crafting grid. Only taken from. |
| `furnace` | The furnace the menu's open on: `ingredient` (no stacks with metadata), `fuel` (only fuel), `result` (only taken from). |
| `chest` | The chest the menu's open on: its 30, then its partner's 30, if it's one of a pair. |
| `coins` | The inventory's coin slots, one for each denomination (`assets/config/worldcraft/currency.lua`), which takes only its own coin. They always exist. |
| `shop` | The merchant the menu's open on: one of each of its wares, its price in its tooltip. A click buys one onto the stack the cursor holds (`assets/npc/README.md`). While the shop's open, the merchant faces the player. |

A menu showing a container that isn't there (a furnace's, open on a block that isn't a furnace, or one broken while it's open; a merchant that's died or gone) closes.

A value there's none of shows as `?`.

## The game's own menus

`assets/config/worldcraft/menus.lua` names the menus the game opens itself, by what for:

| Field | |
|---|---|
| `death` | Opened when the player dies. Without one, the player comes straight back to life. |
| `settings` | Opened by the menu key (Esc) while playing. |
| `inventory` | Opened by the inventory key (E) while playing. E closes a menu with slots. |
| `shop` | Opened on a merchant right-clicked holding a coin. |
| `hud` | A list: the HUD's layers (`assets/hud/README.md`), drawn in order while playing. |
local ui = require("worldcraft:menus")
return {
  components = {
    ui.inventory(),
    ui.panel {anchor = "top_right", at = {-40, 40}, padding = 6, children = {
      ui.text {text = "Chest"},
      ui.slots {at = {8, 26}, container = "chest", count = 40, columns = 4},
    }},
    ui.hotbar {anchor = "bottom", at = {0, -4}},
  },
}local ui = require("worldcraft:menus")
return {
  components = {
    ui.inventory(3),
    ui.hotbar {anchor = "bottom", at = {0, -4}},
  },
}
local ui = require("worldcraft:menus")

return {
  about = "Shown when the player dies: the window washed red, and Respawn.",
  size = {220, 78},
  closable = false,
  tint = {0.47, 0, 0, 0.43},
  components = {
    ui.text {at = {0, 8}, size = {220, 8}, align = "center", scale = 1, text = "You died!", color = {0.6, 0.05, 0.05}},
    ui.button {at = {10, 44}, size = {200, 24}, label = "Respawn", on_click = function(ctx)
      ctx.player:respawn()
      ctx.menu:close()
    end},
  },
}
local ui = require("worldcraft:menus")
return {
  components = {
    ui.inventory(),
    ui.panel {anchor = "top_right", at = {-40, 40}, padding = 6, children = {
      ui.text {text = "Furnace"},
      ui.row {gap=4, align = "center", children = {
        ui.column {gap = 4, children = {
          ui.slot {at = {121, 26}, container = "furnace", index = "ingredient"},
          ui.slot {at = {121, 76}, container = "furnace", index = "fuel"},
        }},
        ui.progress {at = {173, 73}, size = {42, 4}, value = "furnace.progress", label = "=>"},
        ui.slot {at = {235, 51}, container = "furnace", index = "result"},
      }}
    }},
    ui.hotbar {anchor = "bottom", at = {0, -4}},
  },
