}
return {
  about = "Each part's textures are as the door stands facing east: its front and back east and west, its edges north and south, its ends top and bottom.",
  flags = {"solid", "cutout", "needs_support"},
  shape = "worldcraft:door",
  support = "below",
  placed = "facing",
  textures = "worldcraft:planks",
  parts = {
    {
      textures = {
        east = "worldcraft:door_lower",
        west = "worldcraft:door_lower",
        north = "worldcraft:door_lower_side",
        south = "worldcraft:door_lower_side",
        top = "worldcraft:door_end",
