# The Nurse: a showcase of the NPC system. The player heals by eating meat;
# a day later the Nurse arrives and moves into the room built for her (a
# table, a light and a door), her name over her head. Talked to, she says a
# line; with coins in hand, her shop opens, and a Bandage is bought. At
# night she has other things to say.
# worldcraft --demo demos/nurse.demo --demo-out demo_out --gif demo_out/nurse.gif
seed 1
mobs off
view 4
window 960 600

wait_loaded
time 0.4
mark
record off
# A stone platform high in the air, and on it a room with glass walls:
# 5 x 5 inside, 3 high, a table, a torch and a door.
fill @-12 @-10 @40 @20 @10 @40 worldcraft:stone
fill @-12 @-10 @41 @20 @10 @52 core:air
fill @4 @-3 @41 @10 @3 @44 worldcraft:glass
fill @5 @-2 @41 @9 @2 @43 core:air
setblock @9 @2 @41 worldcraft:table
setblock @5 @-2 @41 worldcraft:torch
setblock @4 @0 @41 worldcraft:door[facing=east]
setblock @4 @0 @42 worldcraft:door[facing=east,part=1]
# Up in the air, to fall and be hurt.
teleport @-2 @0 @50
look 0 -10
record on
wait 1.6

# Hurt, the player eats raw meat: the first healing item they've used.
give worldcraft:meat 1 hand
wait 0.5
mouse right
