eye_height = 1.62
crouch_eye_height = 1.32
eye_height_speed = 2.5

# --- Moving ---

walk_speed = 4.317
# Crouching walks this much slower, and won't step off a drop deeper than
# crouch_max_drop.
crouch_speed_factor = 0.3
crouch_max_drop = 0.6
# Walking into a ledge this high (a slab, a stair) steps up onto it.
step_height = 0.5625
gravity = -32
max_fall_speed = -78.4
jump_velocity = 8.4
# Degrees per second when turning with the arrow keys.
look_speed = 85

# --- Swimming ---

# Slower in water, sinking slowly; jump swims up.
swim_speed_factor = 0.6
swim_gravity = -6
swim_sink_speed = -2.5
swim_up_accel = 20
swim_up_speed = 4
# Falling in faster than swim_sink_speed, water drags the player down to it:
# the higher, the sooner. A dive goes on about (speed - sink speed) / drag
# blocks: from 30 blocks up (44 blocks/s), 5 blocks under.
swim_drag = 8

# --- Climbing (ladders, rope) ---

# Jump climbs up this fast (blocks per second); crouch holds on; otherwise
# the player slides down no faster than climb_slide_speed. A fall ends
# harmlessly on a ladder or a rope.
climb_speed = 3
climb_slide_speed = 2

# --- Flying (K) ---

# The speed to start with, and the scroll wheel's limits.
fly_speed = 10
fly_speed_min = 1
fly_speed_max = 100
# Rising and falling, as a share of the flying speed.
fly_vertical_ratio = 0.8

# --- Reach ---

# How far the player points at blocks, and reaches to hit mobs.
reach_blocks = 5
reach_mobs = 5

# --- Health ---

# Hit points (two per heart), and seconds of breath underwater.
max_health = 20
max_air = 10
# Falls this far don't hurt; every block beyond costs a hit point.
safe_fall = 3
# Out of breath: drown_damage every drown_interval seconds.
drown_damage = 2
drown_interval = 1
# Not hurt for heal_delay seconds, the player heals a hit point every
# heal_interval seconds.
heal_delay = 5
heal_interval = 4
# Seconds the screen flashes red when hurt.
hurt_flash = 0.4
# How faces are shaded, as a painter would: faces turned from the light go
# darker and lean towards a shadow hue, and lit faces can take on a tinge of
# the light's own colour. It changes through the day: from the day's
# settings, as the sun nears the horizon, to sunrise's or sunset's.
# Faces lit by torches and lamps rather than the sky keep the day's.
#
# For each of day, sunrise and sunset (sunrise and sunset start from the
# day's, so need only what differs):
#   _shadow_hue       red green blue (0-1): the hue shaded faces lean
#                     towards. Only the hue counts, not how bright it is.
#   _shadow_strength  how far: a face with shade s (top 1, sides 0.8 and
#                     0.6, bottom 0.5) goes (1 - s) times this of the way.
#   _shadow_depth     how much darker shaded faces are: 1 as their shade
#                     says, more is darker.
#   _light_hue        red green blue: the light's colour, on every face as
#                     far as it isn't leaning to the shadow hue. Hue only.
#   _light_strength   how strongly (0 none, 1 fully).

day_shadow_hue = 0.55 0.65 1.0
day_shadow_strength = 1.2
day_shadow_depth = 1.0
day_light_hue = 1.0 1.0 1.0
day_light_strength = 0

# A cold dawn: bluer shadows, and a warm orange-yellow on what the sun lights.
sunrise_shadow_hue = 0.4 0.55 1.0
sunrise_shadow_strength = 1.6
sunrise_light_hue = 1.0 0.8 0.45
sunrise_light_strength = 1.0

# Sunset: deeper, purple shadows, and red on what the sun lights.
sunset_shadow_hue = 0.7 0.45 1.0
sunset_shadow_strength = 1.5
sunset_shadow_depth = 1.35
sunset_light_hue = 1.0 0.45 0.35
sunset_light_strength = 1.0

# How high the sun is when sunrise's or sunset's shading starts taking over
# from the day's: the sine of its angle above the horizon (0.3 is about 17
# degrees). At the horizon it's all theirs.
horizon_reach = 0.3

# How dark ambient occlusion makes the corners where blocks meet: 1 as
# usual, 0 none, more darker (up to 3). Read when the game starts.
ao_strength = 1.5
# The sky's colours through the day. Colours are red green blue, 0 to 1.
# The sky goes from its horizon colour (which is also what the far world
# fades into) to its overhead colour going up.

day_horizon = 0.60 0.76 0.95
day_overhead = 0.36 0.58 0.97
night_horizon = 0.015 0.02 0.06
night_overhead = 0.015 0.02 0.06

# Sunrise and sunset: while the sun is near the horizon the whole sky shifts
# towards their horizon and overhead colours, and glows round the sun, most
# near the horizon. The clouds catch the glow too.
#   _glow       the colour round the sun
#   _horizon    what the sky at the horizon (and the fog) shifts towards
#   _overhead   what the sky overhead shifts towards
#   _glow_size  how tightly the glow gathers round the sun: higher, tighter
#   _far        how much of the glow reaches the far side, away from the sun
#               (where the moon is): 0 none, 1 as much as round the sun
#   _strength   how far the sky goes to these colours (0 none, 1 fully)

# A clear dawn: gold and orange round the sun, the sky staying blue above.
sunrise_glow = 1.0 0.3 0.2
sunrise_horizon = 0.98 0.62 0.4
sunrise_overhead = 0.36 0.5 0.9
sunrise_glow_size = 4
sunrise_far = 0.15
sunrise_strength = 0.9

# Dusk: hot pink round the sun, magenta at the horizon, purple above.
sunset_glow = 1.0 0.3 0.5
sunset_horizon = 0.85 0.35 0.6
sunset_overhead = 0.45 0.28 0.62
sunset_glow_size = 3
sunset_far = 0.3
sunset_strength = 0.95

# How high the sun is when sunrise's or sunset's colours start: the sine of
# its angle above (or below) the horizon (0.35 is about 20 degrees).
horizon_reach = 0.35

# A faint glow round the moon at night: its colour, how strong, and how
# tightly it gathers (as _glow_size).
moon_halo = 0.55 0.6 0.85
moon_halo_strength = 0.12
moon_halo_size = 24
# Sky light from the side (sky rays).
#
# Sky light comes straight down to the highest block in each column, so
# without these, anything high up (a sky island) leaves everything under it
# dark, however high it is. With them, a cell under something looks at the
# sky sideways too: rays climb from it in these directions, and it starts
# with the sky light below for how many of them get past everything.
# (Light then spreads from it as usual.)
#
# Each ray is three whole numbers, `dx dy up`: it goes dx blocks along X and
# dy along Y for every `up` blocks it climbs. 1 0 1 climbs at 45 degrees
# towards +X (east); 2 0 1 is shallower, 1 0 2 steeper, and 1 1 1 heads for
# a corner. Each number is at most 4 (up at least 1), and there can be up to
# 16 rays, separated by commas. Leave it empty for none.
rays = 1 0 3, -1 0 3, 0 1 3, 0 -1 3

# Sky light (0-15) for 0, 1, 2, ... of the rays reaching the sky: one more
# number than there are rays. Open sky is 15.
levels = 0 12 12 12 12
