local ui = require("worldcraft:menus")
return {
  components = {
    ui.inventory(),
    ui.panel {anchor = "top_right", at = {-40, 40}, padding = 6, children = {
      ui.text {value = "npc.full_name"},
      ui.slots {at = {8, 26}, container = "shop", columns = 10},
      ui.button {size = {72, 18}, label = "Talk", on_click = function(ctx)
        ctx.npc:talk()
      end},
    }},
    ui.hotbar {anchor = "bottom", at = {0, -4}},
