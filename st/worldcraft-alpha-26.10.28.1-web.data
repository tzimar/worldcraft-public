expect_inventory worldcraft:stick 3
spawn worldcraft:cow ~2 ~-3 ~
expect_mobs ~2 ~-3 ~ 1.5 1
hurt ~2 ~-3 ~ 1.5 100
expect_mobs ~2 ~-3 ~ 1.5 0
# Skeletons drop bones (#67) the moment they die, not when their body goes.
# worldcraft --demo demos/bones.demo --demo-out demo_out
