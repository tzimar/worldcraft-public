return {
  about = "A board two pixels thick across the top of its cell, placed beside a wall or another platform, and breaking once it's no longer joined to a wall through platforms beside one another: stood on from above, jumped up through from below, dropped through by crouching. Braced on a wall beside it when there's a platform opposite the wall, or it has fewer than two platforms beside it (the braced_ axes, kept by its rule).",
  flags = {"solid", "neighbour_updates", "updates_when_set"},
  shape = "worldcraft:platform",
  placed_beside = true,
  components = {"braced"},
  on_update = "braced_platform",
